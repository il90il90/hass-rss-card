{
  "version": 1,
  "minor_version": 1,
  "key": "lovelace.dashboard_home",
  "data": {
    "config": {
      "views": [
        {
          "title": "Home",
          "type": "sections",
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "custom:hass-rss-card",
                  "feeds": [
                    { "entity": "sensor.ynet_news_ynet_news" },
                    { "entity": "sensor.mako_news_mako_news" }
                  ],
                  "display": {
                    "preset": "ticker",
                    "show": "title_image",
                    "max_items": 10,
                    "image": {
                      "position": "start",
                      "size": "medium",
                      "fit": "cover",
                      "fallback": "none"
                    }
                  },
                  "animation": {
                    "enabled": true,
                    "type": "carousel",
                    "interval": 5,
                    "transition": "fade",
                    "pause_on_hover": true
                  },
                  "features": {
                    "show_relative_time": true,
                    "show_new_badge": true,
                    "new_badge_duration": 3600,
                    "show_refresh_button": true,
                    "track_read_unread": true
                  },
                  "always_show_latest": true,
                  "rtl": "auto",
                  "tap_action": { "action": "url" }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
