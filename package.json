{
  "name": "hass-rss-card",
  "version": "1.0.6",
  "description": "Home Assistant RSS integration and Lovelace card",
  "type": "module",
  "main": "dist/hass-rss-card.js",
  "scripts": {
    "build": "rollup -c && node scripts/copy-card-to-integration.js",
    "test:presets": "node scripts/card_presets_static_test.mjs",
    "test": "npm run build && npm run test:presets",
    "watch": "rollup -c --watch",
